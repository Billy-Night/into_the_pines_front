---
import { toPlainText } from "astro-portabletext";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import { company } from "../../data/site.js";
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "../../lib/sanity.js";
import {
  createImageUrlBuilder,
  type SanityImageSource,
} from "@sanity/image-url";

export async function getStaticPaths(): Promise<
  { params: { slug: string } }[]
> {
  const SLUGS_QUERY = `*[
    _type == "project" && defined(slug.current)
  ]{
    "params": { "slug": slug.current }
  }`;

  return await sanityClient.fetch(SLUGS_QUERY);
}

const PROJECT_QUERY = `*[
  _type == "project" && slug.current == $slug
][0]`;

const project = await sanityClient.fetch<SanityDocument | null>(PROJECT_QUERY, {
  slug: Astro.params.slug,
});

if (!project) {
  throw new Error(`Project not found: ${Astro.params.slug}`);
}

const { projectId, dataset } = sanityClient.config();

const urlFor = (source: SanityImageSource) =>
  projectId && dataset
    ? createImageUrlBuilder({ projectId, dataset }).image(source)
    : null;

const imageBuilder = project.image ? urlFor(project.image) : null;

const imageUrl = (width: number) =>
  imageBuilder
    ?.width(width)
    .height(Math.round((width * 9) / 16))
    .fit("crop")
    .auto("format")
    .url();

const projectImageUrl = imageUrl(1600);

const projectImageSrcSet = imageBuilder
  ? [640, 960, 1280, 1600, 2400]
      .map((width) => `${imageUrl(width)} ${width}w`)
      .join(", ")
  : undefined;

const publishedDate = project.publishedAt
  ? new Date(project.publishedAt)
  : null;

const hasPublishedDate =
  publishedDate !== null && !Number.isNaN(publishedDate.getTime());

const formattedDate = hasPublishedDate
  ? publishedDate!.toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : null;
---

<BaseLayout title={`${project.title} — ${company.name}`}>
  <Navbar />
  <main id="main">
    <article class="project">
      <header class="project__header">
        <div class="container">
          <a class="project__back" href="/projects/">
            <span aria-hidden="true">←</span>
            Back to projects
          </a>

          <p class="eyebrow">A different perspective / Our work</p>

          <h1 class="project__title">{project.title}</h1>

          {
            hasPublishedDate && (
              <p class="project__date">
                Published
                <time datetime={publishedDate!.toISOString()}>
                  {formattedDate}
                </time>
              </p>
            )
          }
        </div>
      </header>

      {
        projectImageUrl && (
          <div class="container">
            <figure class="project__figure">
              <img
                class="project__image"
                src={projectImageUrl}
                srcset={projectImageSrcSet}
                sizes="(min-width: 82rem) 76rem, 100vw"
                alt={project.image?.alt ?? project.title}
                width="1600"
                height="900"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
          </div>
        )
      }

      {
        project.description.length > 0 && (
          <section class="project__story section" aria-labelledby="story-title">
            <div class="container project__story-layout">
              <div class="project__story-heading">
                <p class="eyebrow">Behind the frame</p>
                <h2 id="story-title">The story.</h2>
              </div>

              <div class="project__body">
                <p class="project-card__description">
                  {toPlainText(project.description || [])}
                </p>
              </div>
            </div>
          </section>
        )
      }

      <div class="container project__navigation">
        <span class="project__navigation-label">More perspectives await.</span>
        <a class="button button--outline" href="/projects/">
          Explore all projects
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>

    <section class="section contact" aria-labelledby="project-contact-title">
      <div class="container contact__inner">
        <div>
          <p class="eyebrow">Your story could be next</p>
          <h2 id="project-contact-title">
            Have a vision?<br />
            Let’s bring it to life.
          </h2>
          <p class="contact__description">
            Tell us about your idea, location, and timeline. We’ll find the
            perspective that makes it yours.
          </p>
        </div>

        <div class="contact__action">
          <a class="button button--dark" href={`mailto:${company.email}`}>
            Start a project
            <span aria-hidden="true">↗</span>
          </a>
          <a class="contact__email" href={`mailto:${company.email}`}>
            {company.email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .project__header {
    padding-block: var(--space-section) var(--space-7);
    background: linear-gradient(
      145deg,
      var(--color-landscape-near),
      var(--color-bg) 75%
    );
  }

  .project__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    margin-bottom: var(--space-7);
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .project__back:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .project__header .eyebrow {
    color: var(--color-accent);
  }

  .project__title {
    max-width: 16ch;
    margin-block: var(--space-5) var(--space-6);
    font-size: var(--font-size-hero);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .project__date {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--color-muted);
    font-size: var(--font-size-sm);
  }

  .project__date time {
    color: var(--color-text);
  }

  .project__figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: var(--color-surface);
  }

  .project__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .project__story-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-8);
    align-items: start;
  }

  .project__story-heading .eyebrow {
    margin-bottom: var(--space-5);
    color: var(--color-accent);
  }

  .project__body {
    min-width: 0;
    max-width: 65ch;
    color: var(--color-muted);
    font-size: var(--font-size-lg);
    overflow-wrap: anywhere;
  }

  /* Portable Text renders child elements in another component. */
  .project__body :global(> * + *) {
    margin-top: var(--space-5);
  }

  .project__body :global(h2),
  .project__body :global(h3),
  .project__body :global(h4) {
    margin-top: var(--space-7);
    color: var(--color-text);
    line-height: var(--line-height-heading);
    letter-spacing: var(--tracking-heading);
  }

  .project__body :global(h2) {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .project__body :global(h3) {
    font-size: var(--font-size-h3);
  }

  .project__body :global(h4) {
    font-size: var(--font-size-lg);
  }

  .project__body :global(> :first-child) {
    margin-top: 0;
  }

  .project__body :global(strong) {
    color: var(--color-text);
  }

  .project__body :global(a) {
    color: var(--color-accent);
  }

  .project__body :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .project__body :global(ul),
  .project__body :global(ol) {
    padding-inline-start: var(--space-6);
  }

  .project__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .project__body :global(li::marker) {
    color: var(--color-accent);
  }

  .project__body :global(blockquote) {
    margin-inline: 0;
    padding: var(--space-5) var(--space-6);
    border-inline-start: var(--focus-width) solid var(--color-accent);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-size-h3);
  }

  .project__body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-small);
  }

  .project__body :global(hr) {
    margin-block: var(--space-7);
    border: 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .project__navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-block: var(--space-7);
    border-top: var(--border-width) solid var(--color-border);
  }

  .project__navigation-label {
    color: var(--color-muted);
  }

  @media (max-width: 48rem) {
    .project__story-layout {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>
<!-- 
Code	Responsibility
getStaticPaths()	Tells Astro which project pages to generate
SLUGS_QUERY	Finds the slugs of your Sanity project documents
sanityClient.fetch()	Retrieves those slugs from Sanity
sanityClient.config()	Retrieves the connection configuration
createImageUrlBuilder()	Creates an image URL builder
urlFor()	Prepares a particular Sanity image for transformation
.width().height().url()	Generates the final transformed image URL -->

<!--  Astro looks for functions named 'getStaticPaths()' when building static dynamic routes. This function declares a special astro funciton that determines which URLs Astro needs to genereate during the build process. The TypeScript type shows what is returned a promise which resolves to an array of objects containing the params and slug for each page which will be generated by Astro. saniityClient is used to fetch all the slugs with the CROQ qeury. This pages are generated at build time. -->
