---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "../../lib/sanity.js";
import {
  createImageUrlBuilder,
  type SanityImageSource,
} from "@sanity/image-url";
import { PortableText } from "astro-portabletext";
const PROJECT_QUERY = `*[_type == "project" && slug.current == $slug][0]`;
const project = await sanityClient.fetch<SanityDocument>(
  PROJECT_QUERY,
  Astro.params,
);

// Astro looks for functions named 'getStaticPaths()' when building static dynamic routes. This function declares a special astro funciton that determines which URLs Astro needs to genereate during the build process.
// The TypeScript type shows what is returned a promise which resolves to an array of objects containing the params and slug for each page which will be generated by Astro.
// saniityClient is used to fetch all the slugs with the CROQ qeury.
// This pages are generated at build time.
export async function getStaticPaths(): Promise<
  { params: { slug: string } }[]
> {
  const SLUGS_QUERY = `*[_type == "project" && defined(slug.current)]{
    "params": {"slug": slug.current}
  }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}
const { projectId, dataset } = sanityClient.config();
const urlFor = (source: SanityImageSource) =>
  projectId && dataset
    ? createImageUrlBuilder({ projectId, dataset }).image(source)
    : null;
const projectImageUrl = project.image
  ? urlFor(project.image)?.width(550).height(310).url()
  : null;
---

<BaseLayout content={{ title: project.title }}>
  <main
    class="container mx-auto min-h-screen max-w-3xl p-8 flex flex-col gap-4"
  >
    <a href="/projects" class="hover:underline">&larr; Back to projects</a>
    {
      projectImageUrl && (
        <img
          src={projectImageUrl}
          alt={project.title}
          class="aspect-video rounded-xl"
          width="550"
          height="310"
        />
      )
    }
    <h1 class="text-4xl font-bold mb-8">{project.title}</h1>
    <div class="prose">
      <p>Published: {new Date(project.publishedAt).toLocaleDateString()}</p>
      {Array.isArray(project.body) && <PortableText value={project.body} />}
    </div>
  </main>
</BaseLayout>
<!-- 
Code	Responsibility
getStaticPaths()	Tells Astro which project pages to generate
SLUGS_QUERY	Finds the slugs of your Sanity project documents
sanityClient.fetch()	Retrieves those slugs from Sanity
sanityClient.config()	Retrieves the connection configuration
createImageUrlBuilder()	Creates an image URL builder
urlFor()	Prepares a particular Sanity image for transformation
.width().height().url()	Generates the final transformed image URL -->